include_guard(GLOBAL)

function(_qpm_json_array output json_variable)
    set(_values)
    string(JSON _type ERROR_VARIABLE _error TYPE "${${json_variable}}" ${ARGN})
    if(NOT _error AND _type STREQUAL "ARRAY")
        string(JSON _length LENGTH "${${json_variable}}" ${ARGN})
        if(_length GREATER 0)
            math(EXPR _last "${_length} - 1")
            foreach(_index RANGE 0 ${_last})
                string(JSON _value GET "${${json_variable}}" ${ARGN} ${_index})
                list(APPEND _values "${_value}")
            endforeach()
        endif()
    endif()
    set("${output}" "${_values}" PARENT_SCOPE)
endfunction()

function(_qpm_absolute_paths output)
    set(_paths)
    foreach(_path IN LISTS ARGN)
        if(NOT _path STREQUAL "")
            get_filename_component(_absolute "${_path}" ABSOLUTE BASE_DIR "${CMAKE_SOURCE_DIR}")
            list(APPEND _paths "${_absolute}")
        endif()
    endforeach()
    set("${output}" "${_paths}" PARENT_SCOPE)
endfunction()

function(qpm_apply_toolchain target)
    if(NOT TARGET "${target}")
        message(FATAL_ERROR "qpm_apply_toolchain: '${target}' is not a CMake target")
    endif()

    if(DEFINED QPM_TOOLCHAIN_DATA_FILE)
        set(_toolchain_file "${QPM_TOOLCHAIN_DATA_FILE}")
    else()
        set(_toolchain_file "${CMAKE_SOURCE_DIR}/toolchain.json")
    endif()
    if(NOT EXISTS "${_toolchain_file}")
        message(FATAL_ERROR "QPM toolchain file not found: ${_toolchain_file}; run 'qpm restore' first")
    endif()

    file(READ "${_toolchain_file}" QPM_TOOLCHAIN_JSON)
    string(JSON _include_dir ERROR_VARIABLE _include_dir_error
        GET "${QPM_TOOLCHAIN_JSON}" includeDir)
    if(_include_dir_error)
        message(FATAL_ERROR "QPM toolchain file has no valid includeDir: ${_toolchain_file}")
    endif()
    get_filename_component(_include_root "${_include_dir}" ABSOLUTE BASE_DIR "${CMAKE_SOURCE_DIR}")

    file(GLOB _include_entries LIST_DIRECTORIES TRUE CONFIGURE_DEPENDS "${_include_root}/*")
    set(_package_include_roots)
    foreach(_entry IN LISTS _include_entries)
        if(IS_DIRECTORY "${_entry}")
            list(APPEND _package_include_roots "${_entry}")
        endif()
    endforeach()

    _qpm_json_array(_include_paths QPM_TOOLCHAIN_JSON compileOptions includePaths)
    _qpm_absolute_paths(_include_paths ${_include_paths})
    _qpm_json_array(_system_includes QPM_TOOLCHAIN_JSON compileOptions systemIncludes)
    _qpm_absolute_paths(_system_includes ${_system_includes})
    _qpm_json_array(_c_flags QPM_TOOLCHAIN_JSON compileOptions cFlags)
    _qpm_json_array(_cpp_flags QPM_TOOLCHAIN_JSON compileOptions cppFlags)

    target_include_directories("${target}" PRIVATE "${_include_root}" ${_include_paths})
    set(_system_include_dirs ${_package_include_roots} ${_system_includes})
    if(_system_include_dirs)
        target_include_directories("${target}" SYSTEM PRIVATE ${_system_include_dirs})
    endif()

    foreach(_flag IN LISTS _c_flags)
        target_compile_options("${target}" PRIVATE "$<$<COMPILE_LANGUAGE:C>:${_flag}>")
    endforeach()
    foreach(_flag IN LISTS _cpp_flags)
        target_compile_options("${target}" PRIVATE "$<$<COMPILE_LANGUAGE:CXX>:${_flag}>")
    endforeach()

    string(JSON _linked_type ERROR_VARIABLE _linked_error
        TYPE "${QPM_TOOLCHAIN_JSON}" linkedBinaries)
    if(NOT _linked_error AND _linked_type STREQUAL "OBJECT")
        string(JSON _linked_json GET "${QPM_TOOLCHAIN_JSON}" linkedBinaries)
        string(JSON _package_count LENGTH "${_linked_json}")
        if(_package_count GREATER 0)
            math(EXPR _last_package "${_package_count} - 1")
            foreach(_index RANGE 0 ${_last_package})
                string(JSON _package_name MEMBER "${_linked_json}" ${_index})
                _qpm_json_array(_binaries _linked_json "${_package_name}")
                _qpm_absolute_paths(_binaries ${_binaries})
                if(_binaries)
                    target_link_libraries("${target}" PRIVATE ${_binaries})
                endif()
            endforeach()
        endif()
    endif()
endfunction()

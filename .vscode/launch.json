{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug qpm2 restore (test_package)",
      "cargo": {
        "args": ["build", "--bin=qpm2", "--package=qpm_cli"],
        "filter": {
          "name": "qpm2",
          "kind": "bin"
        }
      },
      "args": ["restore"],
      "cwd": "${workspaceFolder}/test_package"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug unit tests in library 'qpm_cli'",
      "cargo": {
        "args": ["test", "--no-run", "--lib", "--package=qpm_cli"],
        "filter": {
          "name": "qpm_cli",
          "kind": "lib"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}"
    }
  ]
}
